{
  "info": {
    "name": "VGT Bookstore API",
    "description": "Complete API collection for VGT Bookstore E-commerce Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "ecomm_base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "admin_base_url",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Public APIs (E-commerce)",
      "item": [
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ecomm_base_url}}/api/books?page=1&limit=12",
              "host": ["{{ecomm_base_url}}"],
              "path": ["api", "books"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "12" },
                { "key": "category", "value": "fiction", "disabled": true },
                { "key": "search", "value": "", "disabled": true },
                { "key": "minPrice", "value": "100", "disabled": true },
                { "key": "maxPrice", "value": "500", "disabled": true },
                { "key": "featured", "value": "true", "disabled": true },
                { "key": "sort", "value": "-createdAt", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Single Book",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ecomm_base_url}}/api/books/:id",
              "host": ["{{ecomm_base_url}}"],
              "path": ["api", "books", ":id"],
              "variable": [{ "key": "id", "value": "book_id_here" }]
            }
          }
        },
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ecomm_base_url}}/api/categories",
              "host": ["{{ecomm_base_url}}"],
              "path": ["api", "categories"]
            }
          }
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"book_id_here\",\n  \"customerName\": \"John Doe\",\n  \"customerEmail\": \"john@example.com\",\n  \"customerPhone\": \"+91 9876543210\",\n  \"customerAddress\": \"123 Main St, New Delhi, India 110001\",\n  \"paymentScreenshot\": \"https://res.cloudinary.com/...\"\n}"
            },
            "url": {
              "raw": "{{ecomm_base_url}}/api/orders",
              "host": ["{{ecomm_base_url}}"],
              "path": ["api", "orders"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('admin_token', response.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin.vgt@gmail.com\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": {
              "raw": "{{admin_base_url}}/api/auth/login",
              "host": ["{{admin_base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Books",
      "item": [
        {
          "name": "Get All Books (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{admin_base_url}}/api/admin/books",
              "host": ["{{admin_base_url}}"],
              "path": ["api", "admin", "books"]
            }
          }
        },
        {
          "name": "Create Book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"1984\",\n  \"author\": \"George Orwell\",\n  \"description\": \"A dystopian social science fiction novel...\",\n  \"price\": 349,\n  \"category\": \"fiction\",\n  \"coverImage\": \"https://res.cloudinary.com/...\",\n  \"language\": \"English\",\n  \"pages\": 328,\n  \"publisher\": \"Penguin Books\",\n  \"isbn\": \"9780451524935\",\n  \"featured\": true,\n  \"inStock\": true\n}"
            },
            "url": {
              "raw": "{{admin_base_url}}/api/admin/books",
              "host": ["{{admin_base_url}}"],
              "path": ["api", "admin", "books"]
            }
          }
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 399,\n  \"inStock\": false\n}"
            },
            "url": {
              "raw": "{{admin_base_url}}/api/admin/books/:id",
              "host": ["{{admin_base_url}}"],
              "path": ["api", "admin", "books", ":id"],
              "variable": [{ "key": "id", "value": "book_id_here" }]
            }
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{admin_base_url}}/api/admin/books/:id",
              "host": ["{{admin_base_url}}"],
              "path": ["api", "admin", "books", ":id"],
              "variable": [{ "key": "id", "value": "book_id_here" }]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Orders",
      "item": [
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{admin_base_url}}/api/admin/orders",
              "host": ["{{admin_base_url}}"],
              "path": ["api", "admin", "orders"]
            }
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"verified\",\n  \"trackingNumber\": \"TRK123456789\",\n  \"notes\": \"Payment verified\"\n}"
            },
            "url": {
              "raw": "{{admin_base_url}}/api/admin/orders/:id",
              "host": ["{{admin_base_url}}"],
              "path": ["api", "admin", "orders", ":id"],
              "variable": [{ "key": "id", "value": "order_id_here" }]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Categories",
      "item": [
        {
          "name": "Get All Categories (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{admin_base_url}}/api/admin/categories",
              "host": ["{{admin_base_url}}"],
              "path": ["api", "admin", "categories"]
            }
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mystery\",\n  \"slug\": \"mystery\",\n  \"icon\": \"Search\",\n  \"description\": \"Mystery and thriller novels\"\n}"
            },
            "url": {
              "raw": "{{admin_base_url}}/api/admin/categories",
              "host": ["{{admin_base_url}}"],
              "path": ["api", "admin", "categories"]
            }
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{admin_base_url}}/api/admin/categories/:id",
              "host": ["{{admin_base_url}}"],
              "path": ["api", "admin", "categories", ":id"],
              "variable": [{ "key": "id", "value": "category_id_here" }]
            }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{admin_base_url}}/api/admin/categories/:id",
              "host": ["{{admin_base_url}}"],
              "path": ["api", "admin", "categories", ":id"],
              "variable": [{ "key": "id", "value": "category_id_here" }]
            }
          }
        }
      ]
    }
  ]
}
